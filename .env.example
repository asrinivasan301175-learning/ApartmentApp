# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=ApartmentMaintenanceDb
MYSQL_USER=aptuser
MYSQL_PASSWORD=your_secure_user_password_here
MYSQL_PORT=3306

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
DatabaseProvider=MySQL
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=ApartmentMaintenanceDb;Uid=aptuser;Pwd=your_secure_user_password_here;CharSet=utf8mb4;

# JWT Security
Jwt__Key=GENERATE_A_RANDOM_SECURE_KEY_OF_AT_LEAST_32_CHARACTERS_LONG!
Jwt__Issuer=ApartmentMaintenanceApi
Jwt__Audience=ApartmentMaintenanceClient
Jwt__ExpiryMinutes=120
Jwt__RefreshTokenExpiryDays=7

# CORS
CorsOrigins=http://localhost:5173;http://localhost:3000
